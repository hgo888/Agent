# 统一换行符，避免 Windows/Linux 之间来回改写整份文件
# 默认：文本文件在仓库里一律存 LF，检出时也用 LF
* text=auto eol=lf

# 代码与文本
*.py    text eol=lf
*.ipynb text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.sh    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Windows 批处理必须是 CRLF，否则 cmd 可能解析异常
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件，不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.gz    binary
*.index binary
*.faiss binary
*.onnx  binary
*.pt    binary
*.bin   binary
